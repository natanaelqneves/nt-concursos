---
// Busca sem servidor: o índice (poucas dezenas de itens) vai embutido na página e é filtrado no
// navegador, sem acento e sem diferenciar maiúsculas. Sem JavaScript, o formulário abre /estados/.
import { indiceBusca } from "../lib/navegacao";

interface Props { id?: string; grande?: boolean }
const { id = "busca", grande = false } = Astro.props;
const indice = indiceBusca();
---
<form class={`busca ${grande ? "busca-grande" : ""}`} role="search" action="/estados/" data-busca={id}>
  <label class="visually-hidden" for={`${id}-campo`}>Buscar concurso, órgão, cargo, estado ou banca</label>
  <div class="input-group">
    <input id={`${id}-campo`} class="form-control" type="search" autocomplete="off"
           placeholder="Órgão, cargo, estado ou banca" aria-controls={`${id}-res`} aria-autocomplete="list" />
    <button class="btn btn-primary" type="submit">Buscar</button>
  </div>
  <ul id={`${id}-res`} class="busca-res list-unstyled" role="listbox" hidden></ul>
  <script type="application/json" data-indice set:html={JSON.stringify(indice)} />
</form>
<script>
  const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  document.querySelectorAll<HTMLFormElement>("form[data-busca]").forEach((form) => {
    const campo = form.querySelector<HTMLInputElement>("input")!;
    const res = form.querySelector<HTMLUListElement>(".busca-res")!;
    const dados = JSON.parse(form.querySelector("script[data-indice]")!.textContent || "[]") as
      { t: string; d: string; u: string; k: string }[];
    const idx = dados.map((x) => ({ ...x, s: norm(`${x.t} ${x.d} ${x.k}`) }));
    let achados: typeof idx = [];
    const mostrar = () => {
      const termos = norm(campo.value).split(/\s+/).filter((t) => t.length > 1);
      achados = termos.length ? idx.filter((x) => termos.every((t) => x.s.includes(t))).slice(0, 8) : [];
      res.innerHTML = "";
      if (!termos.length) { res.hidden = true; return; }
      if (!achados.length) {
        const li = document.createElement("li");
        li.className = "vazio"; li.textContent = "Nada encontrado. Tente o nome do órgão, a sigla do estado ou a banca.";
        res.append(li);
      }
      for (const x of achados) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = x.u; a.setAttribute("role", "option");
        const t = document.createElement("strong"); t.textContent = x.t;
        const d = document.createElement("span"); d.textContent = x.d;
        a.append(t, d); li.append(a); res.append(li);
      }
      res.hidden = false;
    };
    campo.addEventListener("input", mostrar);
    form.addEventListener("submit", (e) => {
      if (achados.length) { e.preventDefault(); location.href = achados[0].u; }
    });
    document.addEventListener("click", (e) => { if (!form.contains(e.target as Node)) res.hidden = true; });
    campo.addEventListener("keydown", (e) => { if (e.key === "Escape") { res.hidden = true; campo.blur(); } });
  });
</script>
