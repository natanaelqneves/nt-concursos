---
// Botão que leva só ao site oficial da banca. Não renderiza nada se a banca não estiver mapeada.
import { siteBanca } from "../lib/bancas";

interface Props { banca: string }
const { banca } = Astro.props;
const url = siteBanca(banca);
---
{url && (
  <p class="mt-3 mb-0">
    <a class="btn btn-outline-primary" href={url} rel="nofollow noopener">Ir ao site da banca</a>
    <span class="meta ms-2">site oficial da banca, sem outras fontes</span>
  </p>
)}
