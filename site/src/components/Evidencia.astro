---
import type { Documento, Evidencia } from "../lib/dados";
import { formatarDataHora } from "../lib/tempo";

interface Props {
  ev: Evidencia;
  doc: Documento;
}

const { ev, doc } = Astro.props;
const linkPagina = `${doc.url_final}#page=${ev.pagina}`;
const rotuloDoc = doc.tipo === "retificacao" ? "retificação" : doc.tipo;
---
<details class="evidencia">
  <summary>Ver no edital (pág. {ev.pagina})</summary>
  <blockquote lang="pt-BR">{ev.trecho}</blockquote>
  <p>
    Fonte: <a href={linkPagina} rel="nofollow noopener" target="_blank">{rotuloDoc} oficial, página {ev.pagina}</a>
    · conferido em {formatarDataHora(doc.coletado_em)}
    · SHA-256 <code title={doc.sha256}>{doc.sha256.slice(0, 12)}…</code>
    {ev.aprovado_por && <> · revisado manualmente</>}
  </p>
</details>
