---
import type { Documento, Evidencia } from "../lib/dados";
import { formatarDataHora } from "../lib/tempo";
import { COPIAS, ehCopia } from "../lib/origem";

interface Props {
  ev: Evidencia;
  doc: Documento;
}

const { ev, doc } = Astro.props;
const linkPagina = `${doc.url_final}#page=${ev.pagina}`;
const rotuloDoc = doc.tipo === "retificacao" ? "retificação" : doc.tipo;
const copia = ehCopia(doc);
---
<details class="evidencia">
  <summary>Ver no {doc.tipo === "retificacao" ? "documento" : "edital"} (pág. {ev.pagina})</summary>
  {ev.tabela ? (
    <table class="evidencia-tabela table table-sm table-bordered mb-2">
      <caption>Linha do cronograma do edital</caption>
      <tr><th scope="row">Atividade</th><td>{ev.tabela.atividade}</td></tr>
      <tr><th scope="row">Datas</th><td>{ev.tabela.datas}</td></tr>
    </table>
  ) : (
    <blockquote lang="pt-BR">{ev.trecho}</blockquote>
  )}
  <p>
    Fonte: <a href={linkPagina} rel="nofollow noopener" target="_blank">{copia ? `${rotuloDoc} (cópia publicada por ${COPIAS[doc.fonte]})` : `${rotuloDoc} oficial`}, página {ev.pagina}</a>
    · conferido em {formatarDataHora(doc.coletado_em)}
    · SHA-256 <code title={doc.sha256}>{doc.sha256.slice(0, 12)}…</code>
    {ev.aprovado_por && <> · revisado manualmente</>}
  </p>
</details>
