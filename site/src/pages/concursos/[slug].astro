---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import EvidenciaBox from "../../components/Evidencia.astro";
import type { Campo, Concurso, Prazo } from "../../lib/dados";
import {
  NOME_CATEGORIA,
  encerrado,
  local,
  evidenciaDe,
  inscricaoAberta,
  isencaoAberta,
  titulo,
  todos,
  verificado,
} from "../../lib/dados";
import { formatarData, formatarDataHora } from "../../lib/tempo";
import { SOBRE_CATEGORIA } from "../../lib/categorias";
import { orgaoRevisado } from "../../lib/dados";

export function getStaticPaths() {
  return todos().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Concurso };
const doc = c.documentos.find((d) => d.tipo === "edital") ?? c.documentos[0];

const periodo = (p: Prazo) =>
  p.inicio ? `${formatarData(p.inicio)} a ${formatarData(p.fim!)}` : `até ${formatarData(p.fim!)}`;
const moeda = (v: Campo) =>
  Number(v.valor).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

const linhaPrazo = (rotulo: string, p: Prazo) => ({ rotulo, p, ok: verificado(p) && !!p.fim });
const prazos = [linhaPrazo("Isenção da taxa", c.prazos.isencao), linhaPrazo("Inscrições", c.prazos.inscricao)];

const situacao = encerrado(c)
  ? { texto: "Inscrições encerradas", classe: "selo-encerrado" }
  : isencaoAberta(c)
    ? { texto: "Isenção aberta", classe: "selo-isencao" }
    : inscricaoAberta(c)
      ? { texto: "Inscrições abertas", classe: "selo-isencao" }
      : null;

const evTaxa = c.taxa && verificado(c.taxa) ? evidenciaDe(c, c.taxa) : null;
const evVagas = c.vagas_imediatas && verificado(c.vagas_imediatas) ? evidenciaDe(c, c.vagas_imediatas) : null;
const nome = titulo(c);
const sobreCategoria = SOBRE_CATEGORIA[c.categoria];
const sobreOrgao = orgaoRevisado(c.orgao);

// Resumo do concurso montado só com campos verificados.
const partesResumo: string[] = [];
partesResumo.push(`Concurso ${c.esfera === "federal" ? "federal" : "estadual"} ${/^(Polícia|Defensoria|Controladoria|Câmara|Assembleia)/.test(c.orgao) ? "da" : "do"} ${c.orgao}, organizado pela banca ${c.banca.toUpperCase()}.`);
if (verificado(c.prazos.inscricao) && c.prazos.inscricao.fim) {
  partesResumo.push(c.prazos.inscricao.inicio
    ? `As inscrições vão de ${formatarData(c.prazos.inscricao.inicio)} a ${formatarData(c.prazos.inscricao.fim)}.`
    : `As inscrições vão até ${formatarData(c.prazos.inscricao.fim)}.`);
}
if (verificado(c.prazos.isencao) && c.prazos.isencao.fim) {
  partesResumo.push(isencaoAberta(c)
    ? `O pedido de isenção da taxa está aberto até ${formatarData(c.prazos.isencao.fim)}.`
    : `O prazo para pedir isenção da taxa terminou em ${formatarData(c.prazos.isencao.fim)}.`);
}
if (verificado(c.vagas_imediatas)) {
  partesResumo.push(`O edital prevê ${Number(c.vagas_imediatas!.valor).toLocaleString("pt-BR")} vagas imediatas${c.porte === "grande" ? ", o que o coloca entre os concursos de grande porte" : ""}.`);
}
if (c.cargos.length === 1) partesResumo.push(`O cargo é ${c.cargos[0].nome}.`);
else if (c.cargos.length > 1) partesResumo.push(`São ${c.cargos.length} cargos, listados abaixo.`);
const descricao = verificado(c.prazos.isencao) && c.prazos.isencao.fim
  ? `${nome}: pedido de isenção da taxa até ${formatarData(c.prazos.isencao.fim)}. Datas conferidas no edital oficial.`
  : `${nome}: datas de inscrição e links do edital oficial.`;
---
<Base
  titulo={nome}
  descricao={descricao}
  breadcrumbs={[{ nome: "Início", url: "/" }, { nome, url: `/concursos/${c.slug}/` }]}
>
  <p class="meta">
    {NOME_CATEGORIA[c.categoria]} · {c.esfera === "federal" ? "Federal" : "Estadual"} · {local(c)} · banca {c.banca.toUpperCase()}
  </p>
  <h1>{nome}</h1>
  {situacao && <p><span class={`selo badge rounded-pill ${situacao.classe}`}>{situacao.texto}</span></p>}

  <p class="resumo-concurso">{partesResumo.join(" ")}</p>

  <h2>Prazos</h2>
  <dl class="dados">
    {prazos.map(({ rotulo, p, ok }) => {
      const e = ok ? evidenciaDe(c, p) : null;
      return (
        <>
          <dt>{rotulo}</dt>
          <dd>
            {ok ? periodo(p) : <>Consulte o <a href={doc.url_final} rel="nofollow noopener">edital</a></>}
            {e && <EvidenciaBox ev={e.ev} doc={e.doc} />}
          </dd>
        </>
      );
    })}
    {evVagas && (
      <>
        <dt>Vagas imediatas</dt>
        <dd>
          {Number(c.vagas_imediatas!.valor).toLocaleString("pt-BR")}
          {c.porte === "grande" && <> <span class="selo badge rounded-pill selo-porte">grande porte</span></>}
          <EvidenciaBox ev={evVagas.ev} doc={evVagas.doc} />
        </dd>
      </>
    )}
    {c.taxa && (
      <>
        <dt>Taxa de inscrição</dt>
        <dd>
          {verificado(c.taxa) ? moeda(c.taxa) : "Consulte o edital"}
          {evTaxa && <EvidenciaBox ev={evTaxa.ev} doc={evTaxa.doc} />}
        </dd>
      </>
    )}
  </dl>

  {c.isencao_publicos.length > 0 && verificado(c.prazos.isencao) && (
    <>
      <h2>Quem pode pedir isenção</h2>
      <ul>{c.isencao_publicos.map((p) => <li>{p}</li>)}</ul>
      <p class="meta">Os requisitos completos e os documentos exigidos estão no edital.</p>
    </>
  )}

  <AdSlot formato="meio" slot={import.meta.env.PUBLIC_ADSENSE_SLOT_MEIO} />

  {c.cargos.length > 0 && (
    <>
      <h2>Cargos</h2>
      <p class="meta">Conforme a página do concurso na banca. Vagas e salários de cada cargo só aparecem quando conferidos no edital.</p>
      <ul>
        {c.cargos.map((cargo) => {
          const vagas = verificado(cargo.vagas) ? `${cargo.vagas!.valor} vaga(s)` : null;
          return <li>{cargo.nome}{vagas && ` – ${vagas}`}</li>;
        })}
      </ul>
    </>
  )}

  <section aria-labelledby="sobre">
    <h2 id="sobre">Sobre a instituição</h2>
    {sobreOrgao && (
      <p>
        {sobreOrgao.resumo}
        {sobreOrgao.site && <> Site oficial: <a href={sobreOrgao.site} rel="nofollow noopener">{new URL(sobreOrgao.site).hostname}</a>.</>}
      </p>
    )}
    <h3>{sobreCategoria.titulo}</h3>
    {sobreCategoria.paragrafos.map((p) => <p>{p}</p>)}
  </section>

  <h2>Documentos oficiais</h2>
  <ul>
    {c.documentos.map((d) => (
      <li>
        <a href={d.url_final} rel="nofollow noopener">{d.titulo ?? (d.tipo === "retificacao" ? "Retificação" : d.tipo === "edital" ? "Edital" : d.tipo.toUpperCase())}</a>
        {d.publicado_em && <span class="meta"> · publicado em {formatarData(d.publicado_em)}</span>}
        <span class="meta"> · conferido em {formatarDataHora(d.coletado_em)}</span>
      </li>
    ))}
  </ul>
  <p class="meta">
    Dados extraídos automaticamente e conferidos contra o texto do documento oficial.
    <a href="/metodologia/">Veja como verificamos</a>. Encontrou um erro? <a href="/contato/">Avise-nos</a>.
  </p>
</Base>
