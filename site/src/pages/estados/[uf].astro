---
import Base from "../../layouts/Base.astro";
import ListaGrupo from "../../components/ListaGrupo.astro";
import FaixaUF from "../../components/FaixaUF.astro";
import { ESTADOS, porUf, total, urlEstado } from "../../lib/navegacao";

export function getStaticPaths() {
  return [
    { params: { uf: "nacional" }, props: { uf: "BR" } },
    ...Object.keys(ESTADOS).map((uf) => ({ params: { uf: uf.toLowerCase() }, props: { uf } })),
  ];
}

const { uf } = Astro.props as { uf: string };
const g = porUf(uf);
const nacional = uf === "BR";
const nome = nacional ? "nacionais" : `${ESTADOS[uf].prep} ${ESTADOS[uf].nome}`;
const titulo = nacional ? "Concursos federais de lotação nacional abertos" : `Concursos abertos ${nome}`;
const vazio = nacional
  ? "Nenhum concurso federal de lotação nacional com inscrições abertas nesta edição."
  : `Nenhum concurso federal, estadual ou municipal com inscrições abertas ${nome} nesta edição.`;
---
<Base
  titulo={titulo}
  descricao={nacional
    ? "Concursos de órgãos federais com lotação nacional e inscrições abertas, conferidos no edital oficial."
    : `Concursos federais, estaduais e municipais com inscrições abertas ${nome}: tribunais, polícias, fiscais, educação, saúde, prefeitura da capital e guardas municipais.`}
  noindex={total(g) === 0}
  breadcrumbs={[{ nome: "Início", url: "/" }, { nome: "Por estado", url: "/estados/" }, { nome: nacional ? "Nacionais" : ESTADOS[uf].nome, url: urlEstado(uf) }]}
>
  <p class="meta"><a href="/estados/">Todos os estados</a></p>
  <h1>{titulo}</h1>
  <p class="lead">
    {nacional
      ? "Órgãos federais cujas vagas não são de um estado só: ministérios, agências, autarquias, empresas públicas nacionais e Forças Armadas."
      : `Concursos de órgãos estaduais ${nome}, de órgãos federais com sede no estado e, entre os municipais, da capital (prefeitura e câmara) e das guardas, trânsito e vigilância das cidades com mais de 200 mil habitantes.`}
  </p>
  <FaixaUF atual={uf} />
  <ListaGrupo g={g} vazio={vazio} />
  {!nacional && <p class="mt-3"><a href={urlEstado("BR")}>Veja também os concursos federais de lotação nacional</a>, que podem ter vagas no estado.</p>}
</Base>
