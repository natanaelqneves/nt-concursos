---
// Página do editor: envio de um edital em PDF que falta no site, para conferência.
// O PDF NÃO sai do navegador nem vai ao GitHub (o repositório não guarda PDFs). O que vai é um
// registro JSON com o SHA-256 do arquivo, a URL de onde ele foi baixado e o trecho conferido,
// criado como arquivo novo em data/editais-enviados/ pelo próprio editor, logado na conta dele.
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { REPO } from "../../lib/revisao";

const DIR_DADOS = process.env.NTC_DATA_DIR ?? path.resolve(process.cwd(), "..", "data");

// Concursos que aparecem só como notícia ou como edital avulso, sem edital verificado ainda.
const lerSlugs = (dir: string) =>
  fs.existsSync(dir)
    ? fs.readdirSync(dir).filter((f) => f.endsWith(".json")).map((f) => f.replace(/\.json$/, "")).sort()
    : [];
const slugsNoticia = lerSlugs(path.join(DIR_DADOS, "noticias"));
const avulsos = JSON.parse(fs.readFileSync(path.join(DIR_DADOS, "editais-avulsos.json"), "utf8")) as {
  concursos: { slug: string; titulo: string }[];
};
const verificados = new Set(lerSlugs(path.join(DIR_DADOS, "concursos")));
const sugestoes = [...new Set([...slugsNoticia, ...avulsos.concursos.map((c) => c.slug)])]
  .filter((s) => !verificados.has(s));
---
<Base titulo="Enviar edital em PDF" noindex semAnuncios>
  <h1 class="h3">Enviar edital em PDF para conferência</h1>
  <p class="text-secondary">
    Use para um edital que o coletor não alcança e que ainda falta no site. Escolha o arquivo: ele
    fica só no seu navegador, e o PDF é mostrado ao lado para você conferir as datas. Preencha o
    trecho exatamente como está no PDF e toque em <strong>Gerar registro</strong>. O GitHub abre com
    o arquivo pronto em <code>data/editais-enviados/</code>; confirme em <em>Commit changes</em>.
  </p>
  <p class="small text-secondary">
    O PDF não é enviado ao GitHub. Guarde o arquivo e a URL de origem: o registro traz o SHA-256 para
    provar que é o mesmo documento.
  </p>

  <div class="row g-4 mt-1">
    <div class="col-lg-6">
      <form id="form-edital" class="card shadow-sm">
        <div class="card-body d-flex flex-column gap-3">
          <div>
            <label class="form-label" for="pdf">Arquivo do edital (PDF)</label>
            <input class="form-control" type="file" id="pdf" accept="application/pdf,.pdf" required />
            <div class="small text-secondary mt-1" id="info-pdf">Nenhum arquivo escolhido.</div>
          </div>

          <div>
            <label class="form-label" for="slug">Concurso (slug)</label>
            <input class="form-control" id="slug" list="sugestoes" required pattern="[a-z0-9\-]+"
                   placeholder="ex.: banestes-2026" />
            <datalist id="sugestoes">
              {sugestoes.map((s) => <option value={s} />)}
            </datalist>
            <div class="form-text">Use o slug do concurso no repositório (data/noticias ou data/editais-avulsos).</div>
          </div>

          <div>
            <label class="form-label" for="origem">URL de onde o PDF foi baixado</label>
            <input class="form-control" type="url" id="origem" required placeholder="https://..." />
          </div>

          <div class="row g-2">
            <div class="col-8">
              <label class="form-label" for="titulo">Título do documento</label>
              <input class="form-control" id="titulo" required placeholder="Edital nº 03/2026 (retificação)" />
            </div>
            <div class="col-4">
              <label class="form-label" for="publicado">Publicado em</label>
              <input class="form-control" type="date" id="publicado" required />
            </div>
          </div>

          <div class="row g-2">
            <div class="col-4">
              <label class="form-label" for="pagina">Página no PDF</label>
              <input class="form-control" type="number" min="1" id="pagina" required />
            </div>
            <div class="col-8">
              <label class="form-label" for="trecho">Trecho do edital (literal)</label>
              <textarea class="form-control" id="trecho" rows="3" required
                        placeholder="Copie exatamente como está no PDF, com a data"></textarea>
            </div>
          </div>

          <fieldset>
            <legend class="h6">Prazos conferidos no PDF (preencha só o que o trecho diz)</legend>
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label small" for="isen-ini">Isenção: início</label>
                <input class="form-control" type="date" id="isen-ini" />
              </div>
              <div class="col-6">
                <label class="form-label small" for="isen-fim">Isenção: fim</label>
                <input class="form-control" type="date" id="isen-fim" />
              </div>
              <div class="col-6">
                <label class="form-label small" for="insc-ini">Inscrição: início</label>
                <input class="form-control" type="date" id="insc-ini" />
              </div>
              <div class="col-6">
                <label class="form-label small" for="insc-fim">Inscrição: fim</label>
                <input class="form-control" type="date" id="insc-fim" />
              </div>
            </div>
          </fieldset>

          <div>
            <label class="form-label" for="obs">Observação (opcional)</label>
            <input class="form-control" id="obs" placeholder="ex.: retificação que prorroga o prazo" />
          </div>

          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="confere" required />
            <label class="form-check-label" for="confere">
              Conferi no PDF que o trecho aparece literalmente na página indicada.
            </label>
          </div>

          <div>
            <button type="submit" class="btn btn-primary">Gerar registro</button>
            <p class="small text-danger mt-2 mb-0" id="erro" hidden></p>
          </div>
        </div>
      </form>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h6">Pré-visualização do PDF</h2>
          <iframe id="visor" title="Edital em PDF" class="w-100 border rounded" style="min-height: 70vh;" hidden></iframe>
          <p class="small text-secondary mb-0" id="sem-pdf">Escolha um PDF para ver aqui.</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ REPO }}>
    const form = document.getElementById("form-edital");
    const inputPdf = document.getElementById("pdf");
    const infoPdf = document.getElementById("info-pdf");
    const visor = document.getElementById("visor");
    const semPdf = document.getElementById("sem-pdf");
    const erro = document.getElementById("erro");
    const pagina = document.getElementById("pagina");
    let arquivo = null;
    let sha256 = null;
    let urlVisor = null;

    function agoraBRT() {
      // Brasília sem horário de verão: UTC-3
      const d = new Date(Date.now() - 3 * 3600 * 1000);
      const p = (n) => String(n).padStart(2, "0");
      const data = `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())}`;
      const hora = `${p(d.getUTCHours())}:${p(d.getUTCMinutes())}:${p(d.getUTCSeconds())}`;
      return { iso: `${data}T${hora}-03:00`, arquivo: `${data.replaceAll("-", "")}-${hora.replaceAll(":", "")}` };
    }

    function hexSha256(buffer) {
      return crypto.subtle.digest("SHA-256", buffer).then((h) =>
        [...new Uint8Array(h)].map((b) => b.toString(16).padStart(2, "0")).join(""));
    }

    inputPdf.addEventListener("change", async () => {
      arquivo = inputPdf.files[0] ?? null;
      sha256 = null;
      if (!arquivo) {
        infoPdf.textContent = "Nenhum arquivo escolhido.";
        visor.hidden = true; semPdf.hidden = false;
        return;
      }
      if (urlVisor) URL.revokeObjectURL(urlVisor);
      urlVisor = URL.createObjectURL(arquivo);
      visor.src = urlVisor;
      visor.hidden = false; semPdf.hidden = true;
      infoPdf.textContent = `${arquivo.name} · ${(arquivo.size / 1024).toFixed(0)} KB · calculando SHA-256…`;
      sha256 = await hexSha256(await arquivo.arrayBuffer());
      infoPdf.textContent = `${arquivo.name} · ${(arquivo.size / 1024).toFixed(0)} KB · SHA-256 ${sha256}`;
    });

    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      if (!arquivo || !sha256) {
        erro.textContent = "Escolha o PDF e espere o cálculo do SHA-256.";
        erro.hidden = false;
        return;
      }
      const slug = document.getElementById("slug").value.trim();
      const prazo = (ini, fim) => {
        const i = document.getElementById(ini).value;
        const f = document.getElementById(fim).value;
        return i || f ? { inicio: i || null, fim: f || null } : null;
      };
      const isencao = prazo("isen-ini", "isen-fim");
      const inscricao = prazo("insc-ini", "insc-fim");
      if (!isencao && !inscricao) {
        erro.textContent = "Preencha pelo menos um prazo (isenção ou inscrição).";
        erro.hidden = false;
        return;
      }
      erro.hidden = true;
      const agora = agoraBRT();
      const registro = {
        schema_version: 1,
        slug,
        enviado_em: agora.iso,
        arquivo: { nome: arquivo.name, bytes: arquivo.size, sha256 },
        origem_url: document.getElementById("origem").value.trim(),
        documento: {
          titulo: document.getElementById("titulo").value.trim(),
          publicado_em: document.getElementById("publicado").value,
        },
        pagina: Number(pagina.value),
        trecho: document.getElementById("trecho").value.trim(),
        prazos: { isencao, inscricao },
        observacao: document.getElementById("obs").value.trim() || null,
        conferido_pelo_editor: true,
      };
      const url = new URL(`https://github.com/${REPO}/new/main`);
      url.searchParams.set("filename", `data/editais-enviados/${slug}/${agora.arquivo}.json`);
      url.searchParams.set("value", JSON.stringify(registro, null, 2) + "\n");
      url.searchParams.set("message", `edital enviado pelo editor: ${slug}`);
      window.open(url.toString(), "_blank", "noopener");
    });
  </script>
</Base>
